<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="?attr/glossaCard"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="4dp">

    <EditText
        android:id="@+id/esInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_spanish_line"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textCapSentences"
        android:textColor="?attr/glossaTextPrimary"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/enInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_translation_line"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textCapSentences"
        android:textColor="?attr/glossaTextSecondary"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/mergeButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_merge_down"
            android:src="@drawable/ic_merge_down"
            app:tint="?attr/glossaTextSecondary" />

        <ImageButton
            android:id="@+id/deleteButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_delete_card"
            android:src="@drawable/ic_close"
            app:tint="?attr/glossaTextSecondary" />
    </LinearLayout>
</LinearLayout>
