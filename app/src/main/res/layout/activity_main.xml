<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Bauhaus theme: flat circle, square and triangle on black. -->
    <com.example.walllearn.ui.BauhausShapesView
        android:id="@+id/bauhausShapes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/navBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/glossaNavBg">

            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottomNav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                app:itemActiveIndicatorStyle="@style/Widget.Glossa.NavIndicator"
                app:itemIconTint="@color/nav_item"
                app:itemTextColor="@color/nav_item"
                app:labelVisibilityMode="labeled"
                app:menu="@menu/bottom_nav" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
