<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingVertical="12dp">

    <TextView
        android:id="@+id/essayTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="?attr/glossaHeadingFont"
        android:textColor="?attr/glossaTextPrimary"
        android:textSize="18sp"
        tools:text="Grammar Before Creativity: A False Sequence" />

    <TextView
        android:id="@+id/essayMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="?attr/glossaTextMuted"
        android:textSize="12sp"
        tools:text="Statement · 491 words" />
</LinearLayout>
