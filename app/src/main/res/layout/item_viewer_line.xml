<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginBottom="8dp"
    android:background="?attr/glossaCard"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/lineText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="?attr/glossaHeadingFont"
        android:lineSpacingMultiplier="1.1"
        android:textColor="?attr/glossaTextPrimary"
        android:textSize="19sp" />

    <TextView
        android:id="@+id/lineTranslation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="?attr/glossaTextSecondary"
        android:textSize="14sp"
        android:textStyle="italic" />
</LinearLayout>
