<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/termText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            tools:text="decontextualized" />

        <TextView
            android:id="@+id/defText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:lineSpacingMultiplier="1.1"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="Removed from a meaningful setting." />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/addVocabButton"
        style="@style/Widget.Material3.Button.TextButton.Icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:contentDescription="@string/btn_add_vocab"
        android:minWidth="0dp"
        android:paddingHorizontal="12dp"
        app:icon="@drawable/ic_add"
        app:iconPadding="0dp"
        app:iconSize="20dp"
        app:iconTint="@color/app_accent" />
</LinearLayout>
